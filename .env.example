# Template only, no real values. Copy to .env.local (git-ignored) for development,
# and set the same variables in the Netlify dashboard for deploys.

# ---- MongoDB: blog posts, admin accounts, login attempts ----
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
# Database name only (not a URL). Keep it separate from other sites on the same cluster.
MONGODB_DB=celestial

# ---- Cloudinary: cover + in-post images ----
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Uploads go under this folder; only images under it can ever be deleted.
CLOUDINARY_FOLDER=celestial-blog

# ---- Admin login ----
# Admins (username + password) live in MongoDB. Add one with:
#   node --env-file=.env.local scripts/add-admin.mjs <username> "<password of 12+ characters>"
# Signs session cookies; 32+ random characters. The script prints one if this is missing.
# Changing it signs every admin out.
SESSION_SECRET=
